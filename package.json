{
  "name": "dsh-custom-python",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: route Python calls to a user-chosen interpreter instead of the bundled runtime.",
  "type": "module",
  "license": "MIT",
  "author": "Zhen <1558597659@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Axiomtic/dsh-custom-python.git"
  },
  "homepage": "https://github.com/Axiomtic/dsh-custom-python#readme",
  "bugs": {
    "url": "https://github.com/Axiomtic/dsh-custom-python/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "python",
    "interpreter",
    "conda",
    "venv"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
